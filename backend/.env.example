# --- database ---------------------------------------------------------------
#
# THE ONLY THING THAT DECIDES WHICH DATABASE IS USED. Nothing else in the code
# branches on the environment, and there is no fallback: if this points at
# PostgreSQL and PostgreSQL is unreachable, the app fails to start rather than
# quietly using a local SQLite file.
#
# Local development (the default when this line is absent) -- one file in
# backend/data, no server to run:
#   DATABASE_URL=sqlite:///./data/marketingos.db
#
# Production / the VPS (PostgreSQL). Use the form below.
#   - `postgresql+psycopg` is SQLAlchemy's name for the psycopg 3 driver. A
#     bare `postgresql://` or `postgres://` is also accepted and is rewritten
#     to this automatically, so a URL pasted from a hosting dashboard works.
#   - The host must be reachable FROM the backend container. `localhost` there
#     means the backend container itself, not the database.
#   - If a password contains @ : / or ? it must be percent-encoded.
#   - Never prefix this with NEXT_PUBLIC_ or any browser-exposed name.
# DATABASE_URL=postgresql+psycopg://APP_USER:APP_PASSWORD@POSTGRES_HOST:5432/APP_DATABASE
#
# Connection pool. PostgreSQL only; ignored for SQLite, which has a single file.
# Each uvicorn worker may hold DB_POOL_SIZE connections plus DB_MAX_OVERFLOW
# more, so keep (DB_POOL_SIZE + DB_MAX_OVERFLOW) x workers comfortably under
# the server's max_connections.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
# How long to keep retrying the first connection at boot. 0 = fail immediately.
# Keep 0 when Compose gates startup on `depends_on: condition: service_healthy`,
# so a bad password fails the deploy loudly instead of hanging.
DB_CONNECT_WAIT_SECONDS=0

# Company timezone. "Today", due dates and daily totals use it; stored timestamps stay UTC.
APP_TIMEZONE=UTC

# Set true behind HTTPS.
COOKIE_SECURE=false

# Extra origins allowed to send writes, comma-separated. You normally need
# NOTHING here: a request proxied through the Next.js rewrite is matched against
# its own Host / X-Forwarded-Host, so the production domain works as-is. Only add
# an entry for a genuine second origin (e.g. the app served from two domains).
# It also feeds the CORS allowlist, so adding an origin makes the API answer
# preflights for it -- do not add a domain you do not control.
DEV_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Permission switches (SRS 7.4)
MEMBER_CAN_CREATE_TASKS=true
MEMBER_CAN_DELETE_ASSIGNED_TASKS=false
MEMBER_CAN_EDIT_TIME=true
TIME_EDIT_WINDOW_DAYS=0
MEMBER_CAN_ADD_LINKS=true
MEMBER_CAN_CREATE_FOLDERS=false

# Timer limits
MAX_TIMER_HOURS=12
MAX_SESSION_HOURS=24
