# Company timezone. "Today", due dates and daily totals use it; stored timestamps stay UTC.
APP_TIMEZONE=UTC

# Set true behind HTTPS.
COOKIE_SECURE=false

# Permission switches (SRS 7.4)
MEMBER_CAN_CREATE_TASKS=true
MEMBER_CAN_DELETE_ASSIGNED_TASKS=false
MEMBER_CAN_EDIT_TIME=true
TIME_EDIT_WINDOW_DAYS=0
MEMBER_CAN_ADD_LINKS=true
MEMBER_CAN_CREATE_FOLDERS=false

# Timer limits
MAX_TIMER_HOURS=12
MAX_SESSION_HOURS=24
